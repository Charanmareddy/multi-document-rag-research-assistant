# Application
APP_NAME=Multi-Document RAG Research Assistant
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/research_assistant.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=100

# LLM provider: gemini | openai | anthropic (configure only when integration exists)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings: gemini | openai | sentence-transformers
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Vector storage
QDRANT_PATH=./data/qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Optional reranking
RERANKER=none
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v5.0-fast
LOCAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=10
RERANK_CANDIDATE_K=20
